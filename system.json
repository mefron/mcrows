  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "resources.stamina",
  "secondaryTokenAttribute": "resources.wounds",
  "url": "https://github.com/mefron/mcrows",
  "manifest": "https://github.com/mefron/mcrows/releases/download/current/system.json",
