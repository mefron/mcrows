{
  "id": "mcrows",
  "title": "Minimal Crows",
  "description": "A minimal crows implementation",
  "version": "0.0.1",
  "compatibility": {
    "minimum": 14,
    "verified": 14
  },
  "authors": [{
    "name": "me"
  }],
  "esmodules": ["module/mcrows.mjs"],
  "styles": ["styles/system-styles.css"],
  "packs": [{
    "name": "monsters",
    "label": "Crows Monsters",
    "type": "Actor"
  },
  {
    "name": "items",
    "label": "Crows Items",
    "type": "Item"
  }],
  "languages": [{
